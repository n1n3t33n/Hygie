    <mxCell id="note_10" parent="1" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;spacingRight=8;fontSize=10;fillColor=#f5f5f5;strokeColor=#666666;size=14;" value="&lt;b&gt;Règle d&#39;architecture (09 Backend Django)&lt;/b&gt; : aucune logique métier dans les views. Chaque app suit le même flux interne : urls.py → views/ → serializers/ → models/ (ORM) ; le calcul métier va dans services/." vertex="1">
      <mxGeometry height="90" width="480" x="80" y="460" as="geometry" />
    </mxCell>
    <mxCell id="note_11" parent="1" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;spacingRight=8;fontSize=10;fillColor=#f5f5f5;strokeColor=#666666;size=14;" value="&lt;b&gt;Odoo différé&lt;/b&gt; (08 Architecture) : au lancement, Django + PostgreSQL suffisent pour le MVP. Le chemin Flutter → Django → Odoo → PostgreSQL n&#39;est pas actif — ajouté quand l&#39;équipe et les stocks grandiront." vertex="1">
      <mxGeometry height="90" width="460" x="1020" y="590" as="geometry" />
