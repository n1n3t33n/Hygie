    <mxCell id="link_9" edge="1" parent="1" source="grp_api" style="html=1;endArrow=open;startArrow=none;strokeWidth=1;fontSize=9;fontColor=#333333;labelBackgroundColor=#FFFFFF;rounded=0;dashed=1;" target="odoo" value="«futur» (voir 08 Architecture)">
